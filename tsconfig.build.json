{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		// Emitted JavaScript must not keep the `.ts` specifiers the source uses.
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
